{
  "name": "the-well-seasoned-life",
  "compatibility_date": "2026-10-31",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "run_worker_first": [
      "/api/editor/*"
    ],
    "html_handling": "auto-trailing-slash"
  },
  "main": "editor/worker.mjs",
  "$schema": "./node_modules/wrangler/config-schema.json",
  "previews": {},
  "build": {
    "command": "npm run build"
  }
}
